POSTGRES_DB=faith
POSTGRES_USER=faith
POSTGRES_PASSWORD=change_me_for_local_use
DATABASE_URL=postgresql+psycopg://faith:change_me_for_local_use@postgres:5432/faith
REDIS_URL=redis://redis:6379/0
MAX_AUDIO_SIZE_MB=20
CACHE_TTL_SECONDS=900
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=2592000
AUTH_REQUIRED=false
# Public OAuth application identifier; this is not a client secret.
YANDEX_CLIENT_ID=your_yandex_client_id
# Local network: *. On VPS replace with the real API domain.
ALLOWED_HOSTS=*
# Set only in your private .env. Never commit real administrator credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
