# Copy this file to .env on the VPS and replace every change_me value.
# Never commit the resulting .env file.
POSTGRES_DB=faith
POSTGRES_USER=faith
POSTGRES_PASSWORD=change_me_database_password
DATABASE_URL=postgresql+psycopg://faith:change_me_database_password@postgres:5432/faith
REDIS_URL=redis://redis:6379/0

MAX_AUDIO_SIZE_MB=20
CACHE_TTL_SECONDS=86400
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=2592000
AUTH_REQUIRED=false

# Public domain and internal names used by health checks.
ALLOWED_HOSTS=faith-audio.ru,135.106.185.68,localhost,127.0.0.1

ADMIN_USERNAME=change_me_admin_name
ADMIN_PASSWORD=change_me_long_admin_password
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
